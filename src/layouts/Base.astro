---
import '../styles/global.css';
import { chapters } from '../chapters';

interface Props {
  title?: string;
  current?: string; // いま開いている章の slug
}
const { title, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | iCAR Tutorial` : 'iCAR Tutorial'}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={`${base}/`}>iCAR Tutorial</a>
      <nav>
        {chapters.map((c) => (
          <a href={`${base}/${c.slug}/1/`} aria-current={c.slug === current ? 'page' : undefined}>
            <span class="num">{c.num}</span>{c.title}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
