---
import Base from './Base.astro';
import { chapters } from '../chapters';

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const i = chapters.findIndex((c) => c.slug === frontmatter.slug);
const chapter = chapters[i];
const prev = chapters[i - 1];
const next = chapters[i + 1];
---
<Base title={chapter.title}>
  <p class="eyebrow">第{chapter.num}章</p>
  <h1>{chapter.title}</h1>
  <p class="lead">{chapter.summary}</p>
  <article>
    <slot />
  </article>
  <nav class="pager">
    {prev ? <a href={`${base}/${prev.slug}/`}>← {prev.title}</a> : <span />}
    {next && <a href={`${base}/${next.slug}/`}>{next.title} →</a>}
  </nav>
</Base>
